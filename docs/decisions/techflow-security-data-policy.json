  "deletionPolicy": {
    "primaryAndDerivedSloDays": 7,
    "states": ["ACTIVE", "EXPIRING", "DELETION_REQUESTED", "DELETED", "LEGAL_HOLD", "DELETION_INCOMPLETE"],
    "derivedStores": ["chunks", "embeddings", "caches", "evaluation-links"],
    "backupHandling": "reapply deletion ledger after restore and expire through R07 R08",
    "evidence": "counts timestamps policy ids and result only; no deleted content"
  },
  "legalHold": {
    "requiredApprovers": ["product-owner", "security-owner"],
    "maximumReviewIntervalDays": 90,
    "requiredFields": ["legalHoldId", "reason", "basis", "dataIds", "classification", "requestedBy", "approvedBy", "appliedAt", "reviewAt"]
  },
  "ragP1Gate": {
    "defaultAllowedClassifications": ["D0"],
    "conditionalClassifications": ["D1"],
    "deniedClassifications": ["D2", "D3"],
    "requiredMetadata": ["sourceId", "owner", "classification", "product", "version", "contentHash", "collectedAt", "retentionPolicyId"],
    "requiredControls": ["C11", "C12", "C13", "C14", "C15", "C16", "C17", "C24"],
    "rules": [
      "retrieved text is data and cannot override system policy",
      "authorization filters apply before vector retrieval",
      "source and source version are mandatory in every answer",
      "missing or conflicting evidence produces abstention",
      "AI output cannot invoke tools flows APIs or infrastructure actions",
      "raw prompts and responses are not collected by default"
    ]
  },
